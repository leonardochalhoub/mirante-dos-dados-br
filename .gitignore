node_modules/
dist/
.vite/
.env*.local
.DS_Store
*.log

# Vite copies these from /data/gold at prebuild — source of truth lives there.
app/public/data/*
# Exception: claude_usage.json comes from local ccusage (~/.claude/projects/),
# not from data/gold/. CI can't regenerate it (no access to home dir), so we
# commit it. The predev/prebuild script refreshes it locally before each build.
!app/public/data/claude_usage.json

# Python (pipelines)
__pycache__/
*.pyc

# Conselho MCP — índice RAG é artefato reproduzível (python conselho_mcp/build_index.py)
conselho_mcp/index/
.venv/
.ipynb_checkpoints/

test-docs/

# Hudi local build workspace (run_rais_hudi_all_years.sh): ~115 GB peak,
# .7z + TXT + Hudi accumulator. Final artifact is uploaded to Volume.
rais_local/

# Claude Code session state — ignore *contents* of .claude/ (not the dir itself)
# so that we can re-include .claude/agents/ which IS part of Mirante's identity.
/.claude/*
!/.claude/agents/data/reference/geobr_municipios_geo.geojson

# Author-provided source/reference material (reviews, journal tables, audio) — not part of repo
/sources-reference/

# Credenciais Databricks do server MCP (segredo)
conselho_mcp/.env

# Bolema published-articles corpus (reference for our submission) — not part of repo
articles/bolema-corpus/

# Auditoria WP#9 — snapshots dos PDFs curriculares (grandes, baixados sob demanda)
articles/snapshots/

# Reproducibility bundle (deploy artifact) — published to a standalone repo
articles/calculo-repro/
