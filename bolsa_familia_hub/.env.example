# Copie para .env (gitignored, perms 600) e preencha.
# As credenciais Databricks são as MESMAS do conselho_mcp — pode copiar de
# conselho_mcp/.env se já as tiver configuradas ali.

DATABRICKS_SERVER_HOSTNAME=dbc-cafe0a5f-07e3.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<WAREHOUSE_ID>
DATABRICKS_TOKEN=dapi...
MIRANTE_CATALOG=mirante_prd

# Qdrant (container docker-compose — 6343/6344 porque 6333/6334 já são usados
# por workshop1-aide neste host)
QDRANT_HOST=localhost
QDRANT_PORT=6343
QDRANT_COLLECTION=bolsa_familia_memory

# Neo4j (container docker-compose — 7475/7688 pelo mesmo motivo)
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha
